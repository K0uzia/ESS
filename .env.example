APP_ENV=local
APP_URL=http://localhost:8080
DB_DSN=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="ESS Finistère"
# Clé secrète des formulaires (64 caractères hexadécimaux) : php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=

# Newsletters : taille d'un lot (cron toutes les 10 min) et plafond sur 24 h (selon le forfait Hostinger)
NEWSLETTER_BATCH=40
NEWSLETTER_DAILY_LIMIT=300
