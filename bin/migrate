#!/usr/bin/env php
<?php
declare(strict_types=1);

// Applique le schéma, puis chaque fichier de migrations/data/ une seule fois, puis le compte initial.
require __DIR__ . '/../app/bootstrap.php';

use App\Core\Db;

$pdo = Db::pdo();
$hasSchema = (bool) $pdo->query("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'schema_migrations'")->fetchColumn();
if (!$hasSchema) {
    $pdo->exec((string) file_get_contents(ROOT . '/migrations/sqlite_init.sql'));
    echo "schéma créé\n";
}

$applied = $pdo->query('SELECT name FROM schema_migrations')->fetchAll(PDO::FETCH_COLUMN);
$files = glob(ROOT . '/migrations/data/*.sql') ?: [];
sort($files);
foreach ($files as $file) {
    $name = basename($file);
    if (in_array($name, $applied, true)) {
        continue;
    }
    $pdo->beginTransaction();
    $pdo->exec((string) file_get_contents($file));
    Db::run('INSERT INTO schema_migrations (name) VALUES (?)', [$name]);
    $pdo->commit();
    echo "appliqué : $name\n";
}

// Compte initial temporaire (décision du 12/10/2026) : bloque la mise en production tant qu'il garde ce mot de passe.
if ((int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn() === 0) {
    Db::run("INSERT INTO users (username, role, password_hash) VALUES ('lacapsule', 'admin', ?)", [App\Core\Auth::hash('lacapsule')]);
    echo "compte initial « lacapsule » créé\n";
}
